export BRANCH_COLOR='36m'

alias grep="grep --color=auto"

export GEMFURY_API_TOKEN="GsM1tgeGkNyFHkFYd5qc"
export GEMFURY_READ_URL="https://repo.fury.io/${GEMFURY_API_TOKEN}/roverdotcom/"

cd /workspaces/web

echo -e "CODESPACESRC\n"

source profile

source /workspaces/web/venv/bin/activate

source /workspaces/web/profile

source /workspaces/web/profile-codespaces

alias claude="~/.local/bin/claude"

alias sp='m shell_plus'

alias web="cd $WEB"

alias pruned='docker system prune -f'

alias lt='dc logs --tail 456'

alias elastichead='docker run -p 9100:9100 mobz/elasticsearch-head:5'

export DC_PARAMS="--profile stripe"

export PRE_COMMIT_ENABLED=true

export ANTHROPIC_AUTH_TOKEN="sk-MSC5sLKQeQlfAHEKZ5O-Dw"

function dcps {
    dc ps  --format='table {{ .Name }}\t{{ .Status }}'
}

function personalize {
    local source_dir="/workspaces/.codespaces/.persistedshare/dotfiles/.claude/skills"
    local target_dir="$HOME/.claude/skills"

    # symlink any new skill dirs from source to target
    _sync_claude_skills "$source_dir" "$target_dir"

    # ensure remote-sync target dir exists for mutagen (see remotesync in .roverrc)
    mkdir -p "$HOME/obsidian/remote-sync"

    # copy personal.py
    cp -f $DOTFILES_PATH/personal.py $WEB/src/aplaceforrover/rover/settings/personal.py
    echo "copied personal.py to $WEB/src/aplaceforrover/rover/settings/personal.py"
}

function dotfiles {
    cd "$DOTFILES_PATH" || return 1

    if [ -n "$(git status --porcelain)" ]; then
        cat <<'EOF'
  _        ____    ____      _    _       ____ _   _    _    _   _  ____ _____ ____
 | |      / __ \  / ___|    / \  | |     / ___| | | |  / \  | \ | |/ ___| ____/ ___|
 | |     | |  | | | |      / _ \ | |    | |   | |_| | / _ \ |  \| | |  _|  _| \___ \
 | |___  | |__| | | |___  / ___ \| |___ | |___|  _  |/ ___ \| |\  | |_| | |___ ___) |
 |_____|  \____/   \____|/_/   \_\_____| \____|_| |_/_/   \_\_| \_|\____|_____|____/

      local changes detected, sync not possible
EOF
        return 1
    fi

    git pull
}