


export PRE_COMMIT_ENABLED=1

alias dc='docker-compose'
alias web='cd ~/projects/web/'
alias dotfiles='cd "$DOTFILES_PATH"'

alias cs='gh cs ssh -- -A'

export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"  # This loads nvm
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"  # This loads nvm bash_completion

export PATH="$HOME/.local/bin:$PATH"

function skillsync()
{
  _sync_claude_skills "$DOTFILES_PATH/.claude/skills" "$HOME/.claude/skills"
}

# Mutagen sync helpers; the work happens in the cloud-env-folder-share skill's
# script, whose references/gotchas.md explains the Roverspace workarounds.
_FOLDER_SHARE="$DOTFILES_PATH/.claude/skills/cloud-env-folder-share/scripts/cloud-env-folder-share.sh"

function remotesync()
{
  local codespace ssh_host
  codespace=$(gh codespace list --json name,state --jq '[.[] | select(.state=="Available")][0].name')
  if [ -z "$codespace" ]; then
    echo "remotesync: no available codespace found"
    return 1
  fi
  ssh_host=$("$_FOLDER_SHARE" codespace-host "$codespace") || return 1
  "$_FOLDER_SHARE" up --kind codespace --host "$ssh_host" \
    --local "$HOME/obsidian/remote-sync" --remote obsidian/remote-sync --name obsidian-remote-sync
}

# Which roverspace `rsp` and `roverspacesync` talk to. ROVERSPACE_TARGET (the
# short workspace name) and ROVERSPACE_USER live in .secrets, which is sourced
# after this file - fine, because both are read when the function runs, not now.
# Switching roverspaces means editing one line of .secrets.
# NB: do not name the var ROVERSPACE_NAME - .bash_profile treats that as "we are
# running inside a roverspace" and would repoint $DOTFILES_PATH and $WEB.
function _roverspace_host()
{
  local name="${1:-$ROVERSPACE_TARGET}"

  if [ -z "$name" ]; then
    echo "roverspace: no target; pass a name or set ROVERSPACE_TARGET in .secrets" >&2
    return 1
  fi

  # accept an already-qualified ssh host as-is
  case "$name" in
    devcontainer.*|*.coder) echo "$name"; return 0 ;;
  esac

  if [ -z "${ROVERSPACE_USER:-}" ]; then
    echo "roverspace: set ROVERSPACE_USER in .secrets to qualify '$name'" >&2
    return 1
  fi

  echo "devcontainer.$name.$ROVERSPACE_USER.coder"
}

# roverspace counterpart to `cs`. Needs the coder VPN up.
function rsp()
{
  local ssh_host
  ssh_host=$(_roverspace_host "$1") || return 1
  ssh -A "$ssh_host"
}

function roverspacesync()
{
  local ssh_host
  ssh_host=$(_roverspace_host "$1") || return 1
  "$_FOLDER_SHARE" up --kind roverspace --host "$ssh_host" \
    --local "$HOME/mutagen" --remote mutagen --name roverspace-mutagen
}
